# ---------------------------------------------------------------------------
# tagmind — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and MUST NOT
# be committed. Every secret below is read from the environment at runtime;
# no credential is ever hard-coded in the source tree.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
TAGMIND_ENV=development              # development | staging | production
TAGMIND_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
TAGMIND_LOG_FORMAT=json              # json | console
TAGMIND_API_HOST=0.0.0.0
TAGMIND_API_PORT=8000
TAGMIND_WORKERS=4
TAGMIND_API_KEY=                     # optional; when set, X-API-Key is required
TAGMIND_CORS_ORIGINS=["http://localhost:3000"]
TAGMIND_ROLE=api                    # api | worker | beat — single image, role dispatch

# --- PostgreSQL (content, labels, profiles, behaviour logs) -----------------
TAGMIND_POSTGRES_HOST=localhost
TAGMIND_POSTGRES_PORT=5432
TAGMIND_POSTGRES_DB=tagmind
TAGMIND_POSTGRES_USER=tagmind
TAGMIND_POSTGRES_PASSWORD=           # REQUIRED in production; use a secret manager
TAGMIND_DATABASE_URL=                # derived from the fields above when empty
TAGMIND_DB_CONNECT_TIMEOUT=3         # seconds; keeps /readyz fast when the DB is unreachable
TAGMIND_DB_POOL_SIZE=10
TAGMIND_DB_MAX_OVERFLOW=10

# --- Redis (cache, task broker, rate limiting) ------------------------------
TAGMIND_REDIS_URL=redis://localhost:6379/0
TAGMIND_REDIS_PASSWORD=

# --- Vector store (pgvector / Chroma) ---------------------------------------
TAGMIND_VECTOR_BACKEND=pgvector      # pgvector | chroma
TAGMIND_VECTOR_DIM=1024               # BGE-M3 dense dimension
TAGMIND_VECTOR_TOP_K=20

# --- Labelling model -------------------------------------------------------
# TAGMIND_LLM_BACKEND is the single authority (deterministic | llm_local | llm_api).
# TAGMIND_LLM_ENABLED is a derived guard, NOT the selector:
#   LLM_ENABLED=false + LLM_BACKEND!=deterministic -> startup error (prevents egress)
#   LLM_ENABLED=true  + LLM_BACKEND=deterministic -> warning, deterministic wins
TAGMIND_LLM_BACKEND=deterministic
TAGMIND_LLM_ENABLED=false            # false => deterministic rule/template mode
TAGMIND_LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
TAGMIND_LLM_API_KEY=                 # never commit a real key
TAGMIND_LLM_MODEL=glm-4-flash
TAGMIND_LLM_TIMEOUT=60
TAGMIND_LLM_MAX_CONCURRENCY=8
TAGMIND_LLM_TEMPERATURE=0.0
TAGMIND_LLM_MAX_TOKENS=2048
TAGMIND_LLM_MAX_RETRIES=3             # 5xx / 超时指数退避的最大尝试次数
TAGMIND_LLM_RETRY_BASE_DELAY=0.5      # seconds; exponential backoff base
TAGMIND_LLM_RETRY_MAX_DELAY=8.0       # seconds; exponential backoff cap
TAGMIND_LLM_LOCAL_API_BASE=http://localhost:11434/v1
TAGMIND_LLM_AUDIT_ENABLED=true
TAGMIND_LLM_CONTEXT_SHRINK_ATTEMPTS=1 # 上下文超长时缩减分块的二次尝试次数
TAGMIND_LLM_HEALTH_PROBE_TIMEOUT=5.0

# --- Preprocessing (T05) ---------------------------------------------------
TAGMIND_CLEAN_RULES_DIR=rules
TAGMIND_AD_WORDS_PATH=rules/ad_words.txt
TAGMIND_CHUNK_MAX_TOKENS=2048
TAGMIND_CHUNK_OVERLAP_CHARS=0
TAGMIND_CLEAN_UNICODE_NORMALIZE=true  # NFKC + 常见繁简/谐音变体映射
TAGMIND_CLEAN_MIN_LENGTH=1
TAGMIND_DEDUP_ENABLED=true
TAGMIND_DEDUP_SIMHASH_DISTANCE=3
TAGMIND_AD_RELEVANCE_THRESHOLD=0.15   # Q16 判据④：广告片段与正文相关度下限
TAGMIND_CLEAN_RULES_HOT_RELOAD=true   # 规则文件变更即刷新 clean_rules_ver

TAGMIND_EMBEDDING_ENABLED=false       # false => deterministic hashing embedding
TAGMIND_EMBEDDING_MODEL=BAAI/bge-m3
TAGMIND_EMBEDDING_DIM=1024

# --- Labelling pipeline ----------------------------------------------------
TAGMIND_LABEL_BATCH_SIZE=50
TAGMIND_LABEL_WORKERS=4
TAGMIND_MAX_CONTENT_CHARS=6000
TAGMIND_CONFLICT_TOP_K=5
TAGMIND_CONFLICT_SIM_THRESHOLD=0.82
TAGMIND_CONFLICT_ENABLED=true

# --- Label taxonomy version / canary ---------------------------------------
# Canary ratio is a percentage (0-100). 0 disables canary entirely.
# TAGMIND_LABEL_CANARY_VERSION empty => canary disabled.
TAGMIND_LABEL_CANARY_RATIO=0.0
TAGMIND_LABEL_CANARY_VERSION=

# --- Quality gate ----------------------------------------------------------
TAGMIND_QUALITY_ENABLED=true
TAGMIND_QUALITY_MIN_SCORE=6.0        # 0-10, below this the content is rejected
TAGMIND_QUALITY_SENSITIVE_WORDS_PATH=rules/sensitive_words.txt
TAGMIND_QUALITY_MIN_LENGTH=20

# --- Recommendation --------------------------------------------------------
TAGMIND_REC_CANDIDATE_SIZE=200       # recall pool before re-ranking
TAGMIND_REC_TOP_K=20                 # final result size
TAGMIND_REC_COLD_START_STRATEGY=trending_latest
TAGMIND_REC_PROFILE_DECAY=0.95       # exponential decay of tag weights
TAGMIND_REC_EXPLORE_RATIO=0.1        # share of exploratory slots

# --- Scheduler -------------------------------------------------------------
TAGMIND_SCHEDULER_ENABLED=true
TAGMIND_SCHEDULER_TIMEZONE=Asia/Shanghai
TAGMIND_JOB_LABEL_CRON=*/5 * * * *
TAGMIND_JOB_PROFILE_CRON=0 * * * *
TAGMIND_JOB_DRIFT_CHECK_CRON=0 3 * * 1
TAGMIND_JOB_CLEANUP_CRON=0 4 * * *

# --- Observability ---------------------------------------------------------
TAGMIND_METRICS_ENABLED=true
TAGMIND_METRICS_PORT=9100
TAGMIND_ALERT_WEBHOOK_URL=            # optional; receives alert payloads
TAGMIND_LOG_RETENTION_DAYS=14
